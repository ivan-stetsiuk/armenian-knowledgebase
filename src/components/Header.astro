---
import { base } from "../lib/site";
interface Props { section?: string }
const { section } = Astro.props;

const nav = [
  { id: "lessons", label: "Lessons", href: `${base}/lessons/` },
  { id: "grammar", label: "Grammar", href: `${base}/grammar/` },
  { id: "vocabulary", label: "Words", href: `${base}/vocabulary/` },
  { id: "how-to", label: "How-to", href: `${base}/how-to/` },
];
---

<header class="head">
  {/* The material. Three stacked panes rather than one: see the header block in
      global.css — a single backdrop-filter ends at a line, and a line is the one
      thing glass does not have. */}
  <div class="head__glass" aria-hidden="true"></div>

  <div class="shell head__in">
    <a class="head__mark" href={`${base}/`}>հայերեն</a>

    <nav class="head__nav" aria-label="Sections">
      {nav.map((n) => (
        <a href={n.href} aria-current={section === n.id ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="head__tools">
      <button class="linkbtn" id="search-open" title="Search  /">Search</button>
      <button class="linkbtn" id="theme" aria-label="Toggle theme">Theme</button>
    </div>
  </div>
</header>
