---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
/* Only h2 and h3. Deeper levels exist inside paradigm tables and would turn the
 * contents into a second copy of the page. */
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 1 && (
  <nav class="toc" aria-label="On this page">
    <p class="rail__label">On this page</p>
    <ul>
      {items.map((h) => (
        <li class={`lvl-${h.depth}`}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
