---
import type { Word } from "../lib/vocab";
import { stem, initialLetter } from "../lib/vocab";
import { base } from "../lib/site";

interface Props {
  words: Word[];
  showLesson?: boolean;
  /* Dividers between letters. Worth it on the thousand-word list, where a
   * reader scrolls looking for a place in the alphabet; pointless on a topic
   * page of forty words, where they would outnumber the words. */
  byLetter?: boolean;
}

const { words, showLesson = true, byLetter = false } = Astro.props;

/* `data-k` is the haystack the filter searches: Armenian, English, the phrase
 * and the tags, lowercased once at build time so typing stays instant across a
 * thousand rows.
 *
 * The lesson number is deliberately not in it. It used to be, and searching for
 * "5" then returned every word whose example sentence happened to contain a
 * five. The number lives in `data-lesson`, which the filter matches exactly on
 * an "L5" query. */
const key = (w: Word) =>
  [w.hy, w.en, w.phrase_hy, w.phrase_en, w.note, ...w.tags].join(" ").toLowerCase();

/* One flat list of rows to render: the words, with a divider slipped in wherever
 * the initial letter changes. Flat rather than a table section per letter,
 * because the filter reorders rows by how well they answer a query and a
 * <tbody> per letter would fence the good answers into their own group. */
type Row = { letter: string; n: number } | { word: Word };
const rows: Row[] = [];
if (byLetter) {
  const per = new Map<string, number>();
  for (const w of words) per.set(initialLetter(w.hy), (per.get(initialLetter(w.hy)) ?? 0) + 1);

  let seen = "";
  for (const w of words) {
    const first = initialLetter(w.hy);
    if (first !== seen) {
      seen = first;
      rows.push({ letter: first, n: per.get(first) ?? 0 });
    }
    rows.push({ word: w });
  }
} else {
  for (const w of words) rows.push({ word: w });
}

const cols = showLesson ? 4 : 3;
---

{/* Out of the text index. A thousand words on the glossary page made it the
    best full-text answer to almost any query, which is how "Lesson 2" used to
    return the word list first. The words are searchable in their own right —
    the search dialog indexes each one as an entry of its own. */}
<div class="table-wrap" data-pagefind-ignore>
  <table class="words">
    <thead>
      <tr>
        <th>Armenian</th>
        <th>English</th>
        <th>In a phrase</th>
        {showLesson && <th>L</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) =>
        "letter" in row ? (
          <tr class="words__letter" data-letter={row.letter}>
            <th colspan={cols} scope="rowgroup">
              <span class="hy">{row.letter}</span> <span class="count">{row.n}</span>
            </th>
          </tr>
        ) : (
          <tr
            data-k={key(row.word)}
            data-hy={row.word.hy.toLowerCase()}
            data-stem={stem(row.word.hy)}
            data-lesson={row.word.lesson}
          >
            <td class="hy">{row.word.hy}</td>
            <td>
              {row.word.en}
              {row.word.note && <em class="note"> {row.word.note}</em>}
            </td>
            <td>
              {row.word.phrase_hy && (
                <>
                  <span class="hy">{row.word.phrase_hy}</span>
                  {row.word.phrase_en && <span class="gloss"> — {row.word.phrase_en}</span>}
                </>
              )}
            </td>
            {showLesson && (
              <td class="num">
                <a href={`${base}/lessons/l${String(row.word.lesson).padStart(2, "0")}/`}>{row.word.lesson}</a>
              </td>
            )}
          </tr>
        )
      )}
    </tbody>
  </table>
</div>

<style>
  .words { width: 100%; border-collapse: collapse; font-size: 0.875rem;
    font-variant-numeric: tabular-nums; }

  /* The filter marks a row by filling it with grey, and flush against the text
     that fill looked like a printing error. The wrapper is pulled out by the
     same amount the cells are padded, so the highlight gains air on both sides
     and every column stays exactly where it was. */
  .table-wrap { margin-inline: calc(-1 * var(--pad)); }
  .words { --pad: 0.55rem; }

  .words thead th {
    text-align: left;
    padding: 0 1.1rem 0.45rem var(--pad);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--label);
    font-weight: 400;
    color: var(--c-grey);
    white-space: nowrap;
  }

  .words td {
    padding: 0.42rem 1.1rem 0.42rem var(--pad);
    border-bottom: 1px solid var(--c-line);
    vertical-align: top;
  }

  .words tbody tr:hover td { background: color-mix(in srgb, var(--c-ink) 3.5%, transparent); }

  /* The row the filter was aiming at, when a word links straight here from the
     alphabet. Marked with a rule rather than a colour: the site has none. */
  .words tbody tr.is-hit td { background: color-mix(in srgb, var(--c-ink) 7%, transparent); }

  /* Matched through its root rather than its spelling: shown, but marked as the
     looser answer it is. */
  .words tbody tr.is-kin td { color: var(--c-ink-2); }
  .words tbody tr.is-kin .hy::after {
    content: "·";
    margin-left: 0.45rem;
    color: var(--c-grey);
  }

  .words td:last-child, .words th:last-child { padding-right: var(--pad); }

  /* Letter dividers. A row of the table rather than a heading between tables,
     so the columns below one letter line up with the columns below every other.
     The rule sits on top of the divider, which is what turns a thousand rows
     into thirty-nine short lists. */
  .words__letter th {
    text-align: left;
    padding: 1.5rem var(--pad) 0.35rem;
    border-bottom: 1px solid var(--c-line);
    font-weight: 400;
  }

  .words__letter:first-child th { padding-top: 0.2rem; }

  .words__letter .hy {
    font-family: var(--font-hy);
    font-size: 1.25rem;
    color: var(--c-ink);
  }

  /* Colour and the parentheses come from the global .count. */
  .words__letter .count { margin-left: 0.35rem; font-size: 0.72rem; }

  .words .hy { font-family: var(--font-hy); }
  .words .gloss { color: var(--c-grey); }
  .words .note { color: var(--c-grey); font-size: 0.92em; }

  /* Every column in this table is ranged left, including this one: a lesson
     number is a label, not a quantity, and nothing is ever added up. */
  .words .num {
    font-size: var(--label);
    color: var(--c-grey);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .words .num a { text-decoration: none; color: inherit; }
  .words .num a:hover { color: var(--c-ink); }
</style>
