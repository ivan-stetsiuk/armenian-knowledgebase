---
import type { Word } from "../lib/vocab";

interface Props {
  words: Word[];
  showLesson?: boolean;
}

const { words, showLesson = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/* `data-k` is the haystack the filter on the index page searches: Armenian,
 * English, the phrase and the lesson number, lowercased once at build time so
 * typing stays instant across a thousand rows. */
const key = (w: Word) =>
  [w.hy, w.en, w.phrase_hy, w.phrase_en, w.note, `l${w.lesson}`, String(w.lesson), ...w.tags]
    .join(" ")
    .toLowerCase();
---

<div class="table-wrap">
  <table class="words">
    <thead>
      <tr>
        <th>Armenian</th>
        <th>English</th>
        <th>In a phrase</th>
        {showLesson && <th>L</th>}
      </tr>
    </thead>
    <tbody>
      {words.map((w) => (
        <tr data-k={key(w)} data-hy={w.hy.toLowerCase()}>
          <td class="hy">{w.hy}</td>
          <td>
            {w.en}
            {w.note && <em class="note"> {w.note}</em>}
          </td>
          <td>
            {w.phrase_hy && (
              <>
                <span class="hy">{w.phrase_hy}</span>
                {w.phrase_en && <span class="gloss"> — {w.phrase_en}</span>}
              </>
            )}
          </td>
          {showLesson && (
            <td class="num"><a href={`${base}/lessons/l${String(w.lesson).padStart(2, "0")}/`}>{w.lesson}</a></td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .words { width: 100%; border-collapse: collapse; font-size: 0.875rem;
    font-variant-numeric: tabular-nums; }

  .words thead th {
    text-align: left;
    padding: 0 1.1rem 0.45rem 0;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--label);
    font-weight: 400;
    color: var(--c-grey);
    white-space: nowrap;
  }

  .words td {
    padding: 0.42rem 1.1rem 0.42rem 0;
    border-bottom: 1px solid var(--c-line);
    vertical-align: top;
  }

  .words tbody tr:hover td { background: color-mix(in srgb, var(--c-ink) 3.5%, transparent); }

  /* The row the filter was aiming at, when a word links straight here from the
     alphabet. Marked with a rule rather than a colour: the site has none. */
  .words tbody tr.is-hit td { background: color-mix(in srgb, var(--c-ink) 6%, transparent); }
  .words tbody tr.is-hit td:first-child { box-shadow: inset 2px 0 var(--c-ink); }

  .words td:last-child, .words th:last-child { padding-right: 0; }

  .words .hy { font-family: var(--font-hy); }
  .words .gloss { color: var(--c-grey); }
  .words .note { color: var(--c-grey); font-size: 0.92em; }

  .words .num {
    font-size: var(--label);
    color: var(--c-grey);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .words .num a { text-decoration: none; color: inherit; }
  .words .num a:hover { color: var(--c-ink); }
</style>
