---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Search from "../components/Search.astro";
import { base, SITE_NAME, SITE_DESCRIPTION } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  section?: string;
}

const { title, description = SITE_DESCRIPTION, section } = Astro.props;
/* The home page is titled with the site name alone; every other page hangs
 * its own name off it. */
const full = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+Armenian:wght@400;500;600&display=swap"
    />

    {/* Applied before first paint so a dark-theme reader never sees a white flash. */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("hy-theme");
          const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.dataset.theme = "dark";
        } catch {}
      })();
    </script>
  </head>

  <body>
    <Header section={section} />
    <main id="content">
      <slot />
    </main>

    {/* Frosts the whole page while a letter is open. It is a sibling of the
        content rather than a filter on it, because backdrop-filter blurs what is
        behind the element, which lets the words and the open letter sit on the
        glass instead of under it. Inert to the pointer, so a click still lands
        on the page and closes the cloud. */}
    <div class="glass" aria-hidden="true"></div>
    <Search />

    <script>
      /* Every page's client-side behaviour. Astro processes this block, so it
         is TypeScript and it is bundled once for the whole site. Each piece is
         a named function that does nothing when its markup is not on the page,
         which is why they can all run unconditionally. */

      /* Theme. Stored per browser; the OS preference is the default. The class
         is already on <html> before first paint (see the inline script in the
         head), so this only has to handle the button. */
      function themeToggle() {
        const root = document.documentElement;
        document.getElementById("theme")?.addEventListener("click", () => {
          const dark = root.dataset.theme === "dark";
          if (dark) delete root.dataset.theme;
          else root.dataset.theme = "dark";
          try { localStorage.setItem("hy-theme", dark ? "light" : "dark"); } catch {}
        });
      }

      /* Tabs. Panels are all visible until this runs, so a paradigm is readable
         with JavaScript off. It just stops being a tab set. */
      function tabs() {
        for (const set of document.querySelectorAll("[data-tabs]")) {
          const btns = [...set.querySelectorAll<HTMLButtonElement>(".tabs__btn")];
          const panels = [...set.querySelectorAll<HTMLElement>(".tabs__panel")];

          const select = (i: number) => {
            btns.forEach((b, n) => {
              b.setAttribute("aria-selected", String(n === i));
              b.tabIndex = n === i ? 0 : -1;
            });
            panels.forEach((p, n) => (p.hidden = n !== i));
          };
          select(0);

          btns.forEach((b, i) => {
            b.addEventListener("click", () => select(i));
            b.addEventListener("keydown", (e) => {
              const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
              if (!d) return;
              e.preventDefault();
              const next = (i + d + btns.length) % btns.length;
              select(next);
              btns[next].focus();
            });
          });
        }
      }

      /* Wide tables scroll inside their own box rather than widening the page.
         Every table in the prose, not only the ones written at the top level:
         a paradigm inside a rule block or a tab set is exactly the kind that
         overflows a 320px screen. */
      function wrapWideTables() {
        for (const table of document.querySelectorAll(".prose table")) {
          if (table.parentElement?.classList.contains("table-wrap")) continue;
          const wrap = document.createElement("div");
          wrap.className = "table-wrap";
          table.replaceWith(wrap);
          wrap.append(table);
        }
      }

      /* Highlight the section currently in view in the contents. */
      function markCurrentSection() {
        const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
        if (!links.length) return;

        const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
        const seen = new Set<string>();

        const mark = (id: string | undefined) => {
          for (const a of links) a.classList.remove("is-active");
          if (id) byId.get(id)?.classList.add("is-active");
        };

        /* A page usually ends with two or three short sections that never reach
           the top third of the window, so scrolling to the very bottom used to
           leave the highlight stuck several entries short. At the bottom of the
           page the last section is the one being read, whatever the observer
           can see. */
        const atBottom = () =>
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

        const update = () => {
          if (atBottom()) return mark([...byId.keys()].pop());
          for (const id of byId.keys()) if (seen.has(id)) return mark(id);
          mark(undefined);
        };

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) seen.add(e.target.id);
              else seen.delete(e.target.id);
            }
            update();
          },
          { rootMargin: "-80px 0px -70% 0px" }
        );
        for (const id of byId.keys()) {
          const el = document.getElementById(id);
          if (el) io.observe(el);
        }
        addEventListener("scroll", update, { passive: true });
      }

      /* A section can be folded away (the exercises on a lesson page, see
         src/plugins/rehype-fold.mjs) and the contents still links to the
         headings inside it. Open what the link points into, then let the
         browser do its own scrolling. */
      function openFoldedTarget() {
        const reveal = () => {
          const id = decodeURIComponent(location.hash.slice(1));
          if (!id) return;
          const target = document.getElementById(id);
          if (!target) return;
          for (let d = target.closest("details"); d; d = d.parentElement?.closest("details") ?? null) {
            d.open = true;
          }
          target.scrollIntoView();
        };
        reveal();
        addEventListener("hashchange", reveal);
      }

      themeToggle();
      tabs();
      wrapWideTables();
      markCurrentSection();
      openFoldedTarget();
    </script>
  </body>
</html>
