---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { words, byArmenian } from "../lib/vocab";
import { base } from "../lib/site";

const lessons = await getCollection("lessons");
const grammar = await getCollection("grammar");
const howto = await getCollection("howto");
const vocab = words();

/* The 39 letters, in the order and the forms the tutor's own table gives in
 * lesson 1. Two of them are digraphs rather than single code points: ՈՒ, which
 * modern Eastern Armenian teaches in place of the obsolete Ւ, and ԵՎ, the
 * ligature written և in lower case. Uppercase throughout — they are being shown
 * as the alphabet here, not as words.
 *
 * The first six lessons are nothing but these, so the alphabet is the contents
 * of the site standing in for a picture of it; pressing a letter shows what has
 * actually been learned under it. */
const ALPHABET = [
  "Ա", "Բ", "Գ", "Դ", "Ե", "Զ", "Է", "Ը", "Թ", "Ժ",
  "Ի", "Լ", "Խ", "Ծ", "Կ", "Հ", "Ձ", "Ղ", "Ճ", "Մ",
  "Յ", "Ն", "Շ", "Ո", "Չ", "Պ", "Ջ", "Ռ", "Ս", "Վ",
  "Տ", "Ր", "Ց", "ՈՒ", "Փ", "Ք", "ԵՎ", "Օ", "Ֆ",
];

/* Words grouped by initial letter. Case-folded, because proper nouns are
 * capitalised in the corpus and Հայաստան belongs under Հ like everything else.
 * The digraphs are tested first: ուտել starts with ՈՒ, not with Ո. */
const initial = (word: string): string => {
  const w = word.trim().toUpperCase();
  if (w.startsWith("ՈՒ")) return "ՈՒ";
  if (w.startsWith("ԵՎ") || w.startsWith("Եւ".toUpperCase()) || word.trim().startsWith("և")) return "ԵՎ";
  return w[0] ?? "";
};

const byLetter = new Map<string, { hy: string; en: string }[]>();
for (const w of vocab) {
  const first = initial(w.hy);
  if (!first) continue;
  if (!byLetter.has(first)) byLetter.set(first, []);
  byLetter.get(first)!.push({ hy: w.hy, en: w.en });
}

/* Up to 30 words per letter reach the page; the cloud draws a dozen of them,
 * picked afresh on each press. Two reasons for the cut. A dozen words have room
 * to breathe where eighteen were crowding each other, and a letter with sixty
 * entries would otherwise always show the same shortest ones — this way the same
 * letter has something different to say the second time you press it.
 *
 * Shorter words first, because they place better, but not exclusively so. */
const cloud: Record<string, { hy: string; en: string }[]> = {};
for (const letter of ALPHABET) {
  const list = (byLetter.get(letter) ?? [])
    .sort((a, b) => a.hy.length - b.hy.length || byArmenian(a.hy, b.hy))
    .slice(0, 30);
  if (list.length) cloud[letter] = list;
}

const sections = [
  { label: "Lessons", href: `${base}/lessons/`, n: lessons.length },
  { label: "Grammar", href: `${base}/grammar/`, n: grammar.length },
  { label: "Words", href: `${base}/vocabulary/`, n: vocab.length },
  { label: "How-to", href: `${base}/how-to/`, n: howto.length },
];
---

<Base title="Armenian Knowledge Base">
  <div class="shell home" id="home">
    <h1 class="sr-only">Armenian Knowledge Base</h1>

    <div>
      <span class="label">Alphabet</span>
      <p class="abc" id="abc">
        {ALPHABET.map((l) =>
          cloud[l] ? (
            <button
              type="button"
              class="abc__l"
              data-l={l}
              aria-pressed="false"
              aria-label={`${l}, ${cloud[l].length} words`}
            >{l}</button>
          ) : (
            <span class="abc__l is-empty">{l}</span>
          )
        )}
      </p>
    </div>

    <div>
      <span class="label">Contents</span>
      <nav class="stack">
        {sections.map((s) => (
          <a href={s.href}>{s.label} <span class="count">{s.n}</span></a>
        ))}
      </nav>
    </div>

    <div>
      <span class="label">Info</span>
      <div class="links">
        <a href={`${base}/admin/`}>Edit</a>
        <a href="https://github.com/ivan-stetsiuk/armenian-knowledgebase">Source</a>
        <span class="sep"></span>
        <a href="https://github.com/ivan-stetsiuk/armenian-knowledgebase/raw/main/decks/armenian.apkg">Anki deck</a>
      </div>
    </div>

    <div class="cloud" id="cloud" aria-live="polite"></div>
  </div>

  <script is:inline define:vars={{ cloud, base }}>
    const home = document.getElementById("home");
    const layer = document.getElementById("cloud");
    const letters = [...document.querySelectorAll(".abc__l[data-l]")];
    let active = null;

    /* The halo cycles through the flag, top stripe first: red, then blue, then
       orange. It is the only feedback that a second press did anything, now
       that there is no caption under the alphabet. */
    const FLAG = ["var(--flag-red)", "var(--flag-blue)", "var(--flag-orange)"];
    let turn = 0;

    /* Jitter for the ring angles and the type sizes. Seeded from the letter and
       the press, so one cloud is internally consistent while two presses of the
       same letter differ. */
    const rnd = (seed) => {
      let x = seed * 9301 + 49297;
      return () => ((x = (x * 9301 + 49297) % 233280) / 233280);
    };

    let closing = null;

    /* Closing is the opening run backwards, not a teardown. The words fade out
       on their own transition — outermost first, which is the reverse of the
       order they arrived in — and only once they are gone do they leave the DOM
       and the alphabet come back down through the glass.
       `immediate` is for the one case where nothing should be animated: a new
       cloud is about to be built in place of this one. */
    function clear(immediate) {
      clearTimeout(closing);

      const kids = [...layer.children];
      kids.forEach((el, i) => (el.style.transitionDelay = (kids.length - 1 - i) * 12 + "ms"));

      layer.classList.remove("is-on");
      home.classList.remove("is-focused");
      document.documentElement.classList.remove("is-glass");
      for (const b of letters) {
        b.classList.remove("is-on");
        b.setAttribute("aria-pressed", "false");
      }
      active = null;

      const settle = () => {
        layer.replaceChildren();
        home.classList.remove("is-lifted");
      };
      if (immediate) settle();
      else closing = setTimeout(settle, 900);
    }

    function show(btn) {
      const letter = btn.dataset.l;
      const list = cloud[letter] || [];
      clear(true);
      active = letter;

      const aura = FLAG[turn++ % FLAG.length];
      home.style.setProperty("--c-aura", aura);

      btn.classList.add("is-on");
      btn.setAttribute("aria-pressed", "true");
      home.classList.add("is-lifted");
      home.classList.add("is-focused");
      document.documentElement.classList.add("is-glass");

      const box = layer.getBoundingClientRect();
      /* The layer covers the shell's padding box, so the words are kept inside
         the same column the rest of the page starts at. */
      const gutter = parseFloat(getComputedStyle(home).paddingLeft) || 8;
      const b = btn.getBoundingClientRect();
      const cx = b.left - box.left + b.width / 2;
      const cy = b.top - box.top + b.height / 2;

      /* How many words, and which. A phone gets fewer: the alternative is a
         dozen words on top of each other, which is not a cloud but a smudge.
         Chosen at random rather than "the first N", so a letter with sixty
         entries stops showing the same handful and says something different
         each time it is pressed. */
      const ceiling = box.width < 560 ? 8 : 12;
      const room = Math.max(5, Math.min(list.length, ceiling));

      const pool = list.slice();
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const shown = pool.slice(0, room);

      /* Bigger words are laid first, so they get the room near the letter. Left
         to last, a long word finds nothing close and has to be flung far out —
         which is exactly how words used to end up stranded on their own. */
      const items = shown
        .map((w, i) => {
          const a = document.createElement("a");
          a.className = "cloud__w hy";
          a.href = base + "/vocabulary/?q=" + encodeURIComponent(w.hy);
          a.textContent = w.hy;
          a.title = w.en;
          a.style.fontSize =
            (box.width < 560 ? 0.88 : 0.95) + Math.random() * (box.width < 560 ? 0.26 : 0.45) + "rem";
          a.style.transitionDelay = i * 26 + "ms";
          layer.append(a);
          return { el: a };
        })
        .map((m) => ({ ...m, w: m.el.offsetWidth, h: m.el.offsetHeight }))
        .sort((p, q) => q.w * q.h - p.w * p.h);

      /* The letter's own box, with air around it. Nothing may land on it. */
      const keepOut = {
        left: b.left - box.left - 14,
        top: b.top - box.top - 10,
        right: b.right - box.left + 14,
        bottom: b.bottom - box.top + 10,
      };

      /* A comet, not a disc.
       *
       * The letter is the head, always — the words come out of the letter you
       * pressed and that has to be legible. But the alphabet is a block in the
       * left column, so a letter usually has a sliver of room on its left and
       * the whole page on its right. Spreading evenly in both directions means
       * half the cloud has nowhere to go.
       *
       * So the search area is squeezed on the side with no room and stretched
       * on the side with plenty: a letter in the middle of a wide layer gets a
       * round cloud, a letter hard against the gutter gets a tail. */
      const roomL = Math.max(1, cx - gutter);
      const roomR = Math.max(1, box.width - gutter - cx);
      const tail = Math.max(0, Math.min(1, 1 - roomL / roomR));

      const west = 0.18 + (1 - tail) * 0.82;   // 1 when there is room, 0.18 when there is none
      const east = 1 + tail * 1.05;            // the tail

      /* Archimedean spiral out from the letter. A word takes the first place it
         fits, so words pack towards the letter and only reach outward when the
         near positions are taken — there is no way for one to be flung far out
         while there is space close in. No overlap is possible by construction,
         which is why there is no relaxation pass any more. */
      const placed = [];
      const reach = Math.min(box.width * 0.46, Math.max(box.height * 0.62, 260));
      const start = Math.hypot(b.width, b.height) / 2 + 26;
      const spin = Math.random() * Math.PI * 2;

      const fits = (m, x, y) => {
        const l = x - m.w / 2, r = x + m.w / 2, t = y - m.h / 2, bt = y + m.h / 2;
        if (l < gutter || r > box.width - gutter || t < 6 || bt > box.height - 6) return false;
        if (r > keepOut.left && l < keepOut.right && bt > keepOut.top && t < keepOut.bottom) return false;
        for (const p of placed) {
          if (r + 14 > p.l && l - 14 < p.r && bt + 6 > p.t && t - 6 < p.b) return false;
        }
        return true;
      };

      for (const m of items) {
        let put = false;
        for (let a = 0; a < 62 && !put; a += 0.28) {
          const radius = start + a * 13;
          if (radius > reach) break;
          const dir = spin + a;
          const dx = Math.cos(dir);
          const x = cx + radius * dx * 1.55 * (dx < 0 ? west : east);
          const y = cy + radius * Math.sin(dir) * 0.82;
          if (!fits(m, x, y)) continue;
          m.x = x;
          m.y = y;
          put = true;
        }
        if (put) {
          placed.push({ l: m.x - m.w / 2, r: m.x + m.w / 2, t: m.y - m.h / 2, b: m.y + m.h / 2 });
          m.el.style.left = m.x + "px";
          m.el.style.top = m.y + "px";
        } else {
          /* Nowhere for it. Better one word fewer than one word on top of
             another, and the reader cannot miss what was never shown. */
          m.el.remove();
        }
      }

      requestAnimationFrame(() => layer.classList.add("is-on"));
    }

    for (const btn of letters) {
      btn.addEventListener("click", () => (active === btn.dataset.l ? clear() : show(btn)));
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && active) clear();
    });

    /* On the document, not on .home: the page is taller than that block, and a
       click in the space below it has to close the cloud too. Clicks on a letter
       or on one of the words are left alone — one opens, the other navigates. */
    document.addEventListener("click", (e) => {
      if (!active) return;
      if (e.target.closest(".abc__l") || e.target.closest(".cloud__w")) return;
      clear();
    });

    /* A resized window would leave the words pointing at the wrong letter. */
    let t;
    addEventListener("resize", () => {
      if (!active) return;
      clearTimeout(t);
      t = setTimeout(() => {
        const btn = letters.find((b) => b.dataset.l === active);
        if (btn) show(btn);
      }, 150);
    });
  </script>
</Base>
