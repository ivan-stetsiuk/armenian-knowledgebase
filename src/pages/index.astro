---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import { words, byArmenian } from "../lib/vocab";
import { base } from "../lib/site";

const lessons = await getCollection("lessons");
const grammar = await getCollection("grammar");
const howto = await getCollection("howto");
const vocab = words();

/* The 39 letters, in the order and the forms the tutor's own table gives in
 * lesson 1. Two of them are digraphs rather than single code points: ՈՒ, which
 * modern Eastern Armenian teaches in place of the obsolete Ւ, and ԵՎ, the
 * ligature written և in lower case. Uppercase throughout — they are being shown
 * as the alphabet here, not as words.
 *
 * The first six lessons are nothing but these, so the alphabet is the contents
 * of the site standing in for a picture of it; pressing a letter shows what has
 * actually been learned under it. */
const ALPHABET = [
  "Ա", "Բ", "Գ", "Դ", "Ե", "Զ", "Է", "Ը", "Թ", "Ժ",
  "Ի", "Լ", "Խ", "Ծ", "Կ", "Հ", "Ձ", "Ղ", "Ճ", "Մ",
  "Յ", "Ն", "Շ", "Ո", "Չ", "Պ", "Ջ", "Ռ", "Ս", "Վ",
  "Տ", "Ր", "Ց", "ՈՒ", "Փ", "Ք", "ԵՎ", "Օ", "Ֆ",
];

/* Words grouped by initial letter. Case-folded, because proper nouns are
 * capitalised in the corpus and Հայաստան belongs under Հ like everything else.
 * The digraphs are tested first: ուտել starts with ՈՒ, not with Ո. */
const initial = (word: string): string => {
  const w = word.trim().toUpperCase();
  if (w.startsWith("ՈՒ")) return "ՈՒ";
  if (w.startsWith("ԵՎ") || w.startsWith("Եւ".toUpperCase()) || word.trim().startsWith("և")) return "ԵՎ";
  return w[0] ?? "";
};

const byLetter = new Map<string, { hy: string; en: string }[]>();
for (const w of vocab) {
  const first = initial(w.hy);
  if (!first) continue;
  if (!byLetter.has(first)) byLetter.set(first, []);
  byLetter.get(first)!.push({ hy: w.hy, en: w.en });
}

/* Up to 30 words per letter reach the page; the cloud draws a dozen of them,
 * picked afresh on each press. Two reasons for the cut. A dozen words have room
 * to breathe where eighteen were crowding each other, and a letter with sixty
 * entries would otherwise always show the same shortest ones — this way the same
 * letter has something different to say the second time you press it.
 *
 * Shorter words first, because they place better, but not exclusively so. */
const cloud: Record<string, { hy: string; en: string }[]> = {};
for (const letter of ALPHABET) {
  const list = (byLetter.get(letter) ?? [])
    .sort((a, b) => a.hy.length - b.hy.length || byArmenian(a.hy, b.hy))
    .slice(0, 30);
  if (list.length) cloud[letter] = list;
}

const sections = [
  { label: "Lessons", href: `${base}/lessons/`, n: lessons.length },
  { label: "Grammar", href: `${base}/grammar/`, n: grammar.length },
  { label: "Words", href: `${base}/vocabulary/`, n: vocab.length },
  { label: "How-to", href: `${base}/how-to/`, n: howto.length },
];
---

<Base title="Armenian Knowledge Base">
  <div class="shell home" id="home">
    <h1 class="sr-only">Armenian Knowledge Base</h1>

    <div>
      <span class="label">Alphabet</span>
      <p class="abc" id="abc">
        {ALPHABET.map((l) =>
          cloud[l] ? (
            <button
              type="button"
              class="abc__l"
              data-l={l}
              aria-pressed="false"
              aria-label={`${l}, ${cloud[l].length} words`}
            >{l}</button>
          ) : (
            <span class="abc__l is-empty">{l}</span>
          )
        )}
      </p>
    </div>

    <div>
      <span class="label">Contents</span>
      <nav class="stack">
        {sections.map((s) => (
          <a href={s.href}>{s.label} <span class="count">{s.n}</span></a>
        ))}
      </nav>
    </div>

    <div>
      <span class="label">Info</span>
      <div class="links">
        <a href={`${base}/admin/`}>Edit</a>
        <a href="https://github.com/ivan-stetsiuk/armenian-knowledgebase">Source</a>
        <span class="sep"></span>
        <a href="https://github.com/ivan-stetsiuk/armenian-knowledgebase/raw/main/decks/armenian.apkg">Anki deck</a>
      </div>
    </div>

    <div class="cloud" id="cloud" aria-live="polite"></div>
  </div>

  <script is:inline define:vars={{ cloud, base }}>
    const home = document.getElementById("home");
    const layer = document.getElementById("cloud");
    const letters = [...document.querySelectorAll(".abc__l[data-l]")];
    let active = null;

    /* The halo cycles through the flag, top stripe first: red, then blue, then
       orange. It is the only feedback that a second press did anything, now
       that there is no caption under the alphabet. */
    const FLAG = ["var(--flag-red)", "var(--flag-blue)", "var(--flag-orange)"];
    let turn = 0;

    /* Jitter for the ring angles and the type sizes. Seeded from the letter and
       the press, so one cloud is internally consistent while two presses of the
       same letter differ. */
    const rnd = (seed) => {
      let x = seed * 9301 + 49297;
      return () => ((x = (x * 9301 + 49297) % 233280) / 233280);
    };

    let closing = null;

    /* Closing is the opening run backwards, not a teardown. The words fade out
       on their own transition — outermost first, which is the reverse of the
       order they arrived in — and only once they are gone do they leave the DOM
       and the alphabet come back down through the glass.
       `immediate` is for the one case where nothing should be animated: a new
       cloud is about to be built in place of this one. */
    function clear(immediate) {
      clearTimeout(closing);

      const kids = [...layer.children];
      kids.forEach((el, i) => (el.style.transitionDelay = (kids.length - 1 - i) * 12 + "ms"));

      layer.classList.remove("is-on");
      home.classList.remove("is-focused");
      document.documentElement.classList.remove("is-glass");
      for (const b of letters) {
        b.classList.remove("is-on");
        b.setAttribute("aria-pressed", "false");
      }
      active = null;

      const settle = () => {
        layer.replaceChildren();
        home.classList.remove("is-lifted");
      };
      if (immediate) settle();
      else closing = setTimeout(settle, 900);
    }

    function show(btn) {
      const letter = btn.dataset.l;
      const list = cloud[letter] || [];
      clear(true);
      active = letter;

      const aura = FLAG[turn++ % FLAG.length];
      home.style.setProperty("--c-aura", aura);

      btn.classList.add("is-on");
      btn.setAttribute("aria-pressed", "true");
      home.classList.add("is-lifted");
      home.classList.add("is-focused");
      document.documentElement.classList.add("is-glass");

      const box = layer.getBoundingClientRect();
      /* The layer covers the shell's padding box, so without this the words can
         sit right against the window edge while every other element on the page
         starts at the gutter. They stay inside the same column as the text. */
      const gutter = parseFloat(getComputedStyle(home).paddingLeft) || 8;
      const b = btn.getBoundingClientRect();
      let cx = b.left - box.left + b.width / 2;
      let cy = b.top - box.top + b.height / 2;

      /* On a narrow screen the cloud sits below the alphabet rather than behind
         it, so the letter is outside the layer and its centre is meaningless.
         Aim at the top of the layer instead and let the rings grow downwards. */
      if (cy < 24 || cy > box.height - 24) cy = Math.min(box.height * 0.42, 190);
      cx = Math.max(70, Math.min(box.width - 70, cx));

      /* The rings are hung off a point pulled back towards the middle of the
         column rather than off the letter itself. A letter on the left of the
         alphabet has almost no room on its left, and centring the rings on it
         put most of the cloud into that sliver — the words ended up huddled
         against the margin with the whole right of the page empty. The letter
         is still the thing they came out of; it just is not the centre of the
         circle. */
      const anchorX = box.width < 560 ? cx + (box.width / 2 - cx) * 0.7 : box.width * 0.46;
      const anchorY = cy + (box.height * 0.46 - cy) * 0.3;

      const next = rnd(letter.codePointAt(0) + Math.floor(Math.random() * 997));

      /* How many the layer can hold, and which ones. A phone gets fewer than a
         desktop, because the alternative is a dozen words on top of each other,
         which is not a cloud but a smudge.

         The choice is random rather than "the first N": a letter with sixty
         entries would otherwise show the same handful for ever. Randomised per
         press, so pressing the same letter twice shows it twice differently. */
      const ceiling = box.width < 560 ? 8 : 12;
      const room = Math.max(5, Math.min(list.length, ceiling, Math.round((box.width * box.height) / 16000)));

      const pool = list.slice();
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const shown = pool.slice(0, room);

      /* Rings around the letter: the radius grows with the ring so later words
         land further out, and the angle is jittered so it never reads as a dial.
         The horizontal radius is stretched, because the page is wider than it is
         tall and a word is wider than it is high.

         Both are scaled to the layer. Fixed radii threw half the words past the
         edge of a phone, where clamping stacked them against the margin — they
         were not clipped, but a column of words pinned to the left edge is not a
         cloud either.

         No ring may start inside the letter either. Scaling alone put the first
         ring at 44px on a phone while the letter itself is about 42px tall, so
         the nearest words landed on top of the thing they belong to. */
      const guard = Math.hypot(b.width, b.height) / 2 + 34;
      const scale = Math.min(1, box.width / 980);
      const spread = box.width < 560 ? 1.15 : 1.95;
      const perRing = box.width < 560 ? 5 : 6;
      const items = shown.map((w, i) => {
        const ring = Math.floor(i / perRing);
        const angle =
          ((i % perRing) / perRing) * Math.PI * 2 + ring * 0.8 + (next() - 0.5) * 0.5;
        const radius = Math.max(guard, (104 + ring * 86 + next() * 44) * Math.max(0.42, scale));

        const a = document.createElement("a");
        a.className = "cloud__w hy";
        a.href = base + "/vocabulary/?q=" + encodeURIComponent(w.hy);
        a.textContent = w.hy;
        a.title = w.en;
        a.style.fontSize = (box.width < 560 ? 0.9 : 0.95) + next() * (box.width < 560 ? 0.3 : 0.5) + "rem";
        a.style.transitionDelay = i * 22 + "ms";
        layer.append(a);

        return {
          el: a,
          x: anchorX + Math.cos(angle) * radius * spread,
          y: anchorY + Math.sin(angle) * radius,
        };
      });

      /* Each word is centred on its coordinates, so it can only be kept inside
         the layer once its own width is known — which is why the measuring pass
         happens after they are all in the DOM. One layout, then arithmetic. */
      const PAD = gutter;
      for (const m of items) {
        m.w = m.el.offsetWidth;
        m.h = m.el.offsetHeight;
      }

      /* The letter's own box, in layer coordinates, with a little air round it.
         Words are pushed out of it the same way they are pushed off each other. */
      const keepOut = {
        left: b.left - box.left - 12,
        top: b.top - box.top - 8,
        right: b.right - box.left + 12,
        bottom: b.bottom - box.top + 8,
      };

      const onLetter = (m) =>
        m.x + m.w / 2 > keepOut.left && m.x - m.w / 2 < keepOut.right &&
        m.y + m.h / 2 > keepOut.top && m.y - m.h / 2 < keepOut.bottom;

      const clearLetter = (m) => {
        if (!onLetter(m)) return false;
        const l = m.x - m.w / 2, r = m.x + m.w / 2;
        const t = m.y - m.h / 2, bt = m.y + m.h / 2;
        // Out along whichever edge is nearest.
        const up = keepOut.top - bt, down = keepOut.bottom - t;
        const west = keepOut.left - r, east = keepOut.right - l;
        const best = Math.min(Math.abs(up), Math.abs(down), Math.abs(west), Math.abs(east));
        if (best === Math.abs(up)) m.y += up;
        else if (best === Math.abs(down)) m.y += down;
        else if (best === Math.abs(west)) m.x += west;
        else m.x += east;
        return true;
      };

      const clamp = (m) => {
        m.x = Math.max(m.w / 2 + PAD, Math.min(box.width - m.w / 2 - PAD, m.x));
        m.y = Math.max(m.h / 2 + PAD, Math.min(box.height - m.h / 2 - PAD, m.y));
      };
      items.forEach(clamp);

      /* One relaxation loop, two forces, the same rule for both: a word is
         pushed out of anything it overlaps along whichever axis it overlaps
         least, then clamped back inside the column. The letter is simply an
         immovable body among the words — it is resolved last in each pass, so
         it always wins the tie.

         Eighty passes is far more than this needs and still costs nothing: it
         is arithmetic on at most eighteen boxes. */
      const gap = box.width < 560 ? 8 : 16;

      const push = (a, c) => {
        const dx = c.x - a.x, dy = c.y - a.y;
        const ox = (a.w + c.w) / 2 + gap - Math.abs(dx);
        const oy = (a.h + c.h) / 2 + 5 - Math.abs(dy);
        if (ox <= 0 || oy <= 0) return false;
        if (oy < ox) { const s = ((dy >= 0 ? 1 : -1) * oy) / 2; a.y -= s; c.y += s; }
        else { const s = ((dx >= 0 ? 1 : -1) * ox) / 2; a.x -= s; c.x += s; }
        clamp(a); clamp(c);
        return true;
      };

      for (let pass = 0; pass < 80; pass++) {
        let moved = false;
        for (let i = 0; i < items.length; i++)
          for (let j = i + 1; j < items.length; j++)
            if (push(items[i], items[j])) moved = true;
        for (const m of items) if (clearLetter(m)) { clamp(m); moved = true; }
        if (!moved) break;
      }

      /* If a word still sits on the letter, the letter is boxed into a corner
         and no push can clear it. Put the word below the letter outright. */
      for (const m of items) {
        if (onLetter(m)) {
          m.y = keepOut.bottom + m.h / 2 + 6;
          clamp(m);
          if (onLetter(m)) m.y = keepOut.top - m.h / 2 - 6;
          clamp(m);
        }
      }

      for (const m of items) {
        m.el.style.left = m.x + "px";
        m.el.style.top = m.y + "px";
      }

      requestAnimationFrame(() => layer.classList.add("is-on"));
    }

    for (const btn of letters) {
      btn.addEventListener("click", () => (active === btn.dataset.l ? clear() : show(btn)));
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && active) clear();
    });

    /* On the document, not on .home: the page is taller than that block, and a
       click in the space below it has to close the cloud too. Clicks on a letter
       or on one of the words are left alone — one opens, the other navigates. */
    document.addEventListener("click", (e) => {
      if (!active) return;
      if (e.target.closest(".abc__l") || e.target.closest(".cloud__w")) return;
      clear();
    });

    /* A resized window would leave the words pointing at the wrong letter. */
    let t;
    addEventListener("resize", () => {
      if (!active) return;
      clearTimeout(t);
      t = setTimeout(() => {
        const btn = letters.find((b) => b.dataset.l === active);
        if (btn) show(btn);
      }, 150);
    });
  </script>
</Base>
