---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const lessons = (await getCollection("lessons")).sort((a, b) => b.data.lesson - a.data.lesson);

---

<Base title="Lessons" section="lessons" description="Chronological record of 41 Armenian lessons.">
  <div class="shell doc" style="grid-template-columns: minmax(0, 60rem); ">
    <div class="doc__body" style="grid-column:1" data-pagefind-body>
      <header class="title">
        <span class="title__no">01 — Chronology</span>
        <h1>Lessons</h1>
        <div class="title__meta">
          <span>{lessons.length} sessions</span>
          <span>newest first</span>
        </div>
      </header>

      <div class="prose" style="margin-bottom:2rem">
        <p>
          What happened in each session: the words introduced, each rule in one line with a link
          to its reference page, and the exercises as they were set.
        </p>
      </div>

      <div class="index">
        {lessons.map((l) => (
          <a class="index__row" href={`${base}/lessons/${l.id}/`}>
            <span class="index__no">{String(l.data.lesson).padStart(3, "0")}</span>
            <span class="index__name">
              {l.data.title}
              {l.data.topics && <span class="index__sub">{l.data.topics}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>
