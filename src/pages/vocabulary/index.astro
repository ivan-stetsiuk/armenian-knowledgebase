---
import Base from "../../layouts/Base.astro";
import WordTable from "../../components/WordTable.astro";
import { words, TOPICS, byArmenian, SUFFIXES, LATIN_FOLD } from "../../lib/vocab";
import { base } from "../../lib/site";

const all = words().sort((a, b) => byArmenian(a.hy, b.hy));

const counts = new Map<string, number>();
for (const w of all) for (const t of w.tags) counts.set(t, (counts.get(t) ?? 0) + 1);

const topics = TOPICS.filter(([tag]) => counts.get(tag)).map(([tag, title, blurb]) => ({
  tag, title, blurb, n: counts.get(tag)!,
}));

---

<Base title="Words" section="vocabulary" description={`${all.length} Armenian words and expressions from the lessons, by topic.`}>
  <div class="shell doc wide">
    <div class="doc__body" data-pagefind-body>
      <header class="title">
        <h1>Words <span class="count">{all.length}</span></h1>
      </header>

      {/* Filter, then the words. Arriving here from a word on the home page the
          search is the thing being used, and the topics are a different way in
          entirely: they belong after the list, not between it and the field. */}
      <div class="filter">
        <input
          type="search"
          id="wfilter"
          placeholder="Filter: Armenian, English, or L7 for one lesson"
          aria-label="Filter words"
          autocomplete="off"
        />
        {/* The same clear button the search panel has. The browser draws one
            of its own on a search field, in its own colour and its own idea of
            a cross; this is that one, hidden, in the site's hand. */}
        <button type="button" class="filter__clear" id="wclear" aria-label="Clear filter" hidden>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none"
               stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
            <path d="M4.5 4.5l7 7M11.5 4.5l-7 7" />
          </svg>
        </button>
        <span class="filter__count" id="wcount">{all.length}</span>
      </div>

      {/* Folded away: thirty-four topic links is a page of its own, and the
          filter answers most visits on its own. Open it and they are there. */}
      <details class="disclosure topics-fold">
        <summary>Topics <span class="count">{topics.length}</span></summary>
        <div class="topics">
          {topics.map((t) => (
            <a class="topic" href={`${base}/vocabulary/${t.tag}/`} title={t.blurb}>
              {t.title} <span class="count">{t.n}</span>
            </a>
          ))}
        </div>
      </details>

      <p class="index__group">All words</p>

      {/* Arriving from the word cloud or from search, the page is asked for one
          word out of a thousand. Without this the browser painted the whole list
          first and the filter then reordered it under the reader's eyes, ending
          with a scroll to a row that had just moved: three frames of thrashing
          for one answer. Marking the document before the table is parsed keeps
          the list unpainted until it is the list that was asked for; the script
          at the foot of the page clears the mark once it is. */}
      <script is:inline>
        if (new URLSearchParams(location.search).get("q")) {
          document.documentElement.dataset.filtering = "1";
        }
      </script>

      <WordTable words={all} showLesson={true} byLetter={true} />

      <p class="filter__empty" id="wempty" hidden>
        Nothing matches. Try the Armenian spelling, or a lesson number.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ SUFFIXES, LATIN_FOLD }}>
    const input = document.getElementById("wfilter");
    const wclear = document.getElementById("wclear");
    const count = document.getElementById("wcount");
    const empty = document.getElementById("wempty");
    const rows = [...document.querySelectorAll("tbody tr[data-k]")];
    const tbody = rows[0]?.parentNode;
    /* Every child of the body, letter dividers included: putting the list back
       the way it was means putting the letters back with it. */
    const original = tbody ? [...tbody.children] : [];

    /* Each divider with the rows filed under it, so a filter can drop the
       letters that nothing was found beneath. */
    const groups = [];
    for (const el of original) {
      if (el.classList.contains("words__letter")) groups.push({ head: el, rows: [] });
      else if (groups.length) groups[groups.length - 1].rows.push(el);
    }

    /* Same rules the build uses, from the same tables: the suffix list and the
       Latin folding are injected as data, so the page and the rows it filters
       cannot drift apart. */
    const stemOf = (w) => {
      const s = w.toLowerCase().trim();
      for (const suf of SUFFIXES) {
        if (s.length - suf.length >= 2 && s.endsWith(suf)) return s.slice(0, -suf.length);
      }
      return s;
    };

    /* Every row carries its word in Latin letters as well (see roman() in
       src/lib/hy.ts), so a query typed in Latin has to be folded the same way
       before it is compared: x and kh are one letter, so are q and k, ou and u. */
    const FOLD_KEYS = Object.keys(LATIN_FOLD).sort((a, b) => b.length - a.length);
    const FOLD_RE = new RegExp(FOLD_KEYS.join("|"), "g");
    const foldLatin = (q) =>
      q.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f'\u2019`]/g, "")
        .replace(FOLD_RE, (m) => LATIN_FOLD[m])
        .replace(/(.)\1+/g, "$1");

    const LATIN = /^[a-z'\u2019 -]+$/i;

    /* A substring match is not the same as the word you asked for. Coming here
       from the alphabet on the home page, the word clicked has to be the first
       row, not the fourteenth, so matches are ordered by how exactly they
       answer the query, and words that merely share its root come last. */
    const rank = (row, q, latin) => {
      const hy = row.dataset.hy || "";
      if (hy === q) return 0;
      /* A word spelled out in Latin is the word itself, not a mention of it. */
      const keys = (row.dataset.r || "").split(" ");
      if (latin && keys.includes(latin)) return 0;
      if (hy.startsWith(q)) return 1;
      if (latin && keys.some((k) => k.startsWith(latin))) return 1;
      if (hy.includes(q) || (row.dataset.k || "").includes(q)) return 2;
      return 3;
    };

    /* "L7" means the seventh lesson and nothing else. Matching it as text was
       the bug: the number went into the haystack, so a search for 5 returned
       every word whose example sentence contained a five, and L1 matched L15
       as a substring. */
    const LESSON = /^l\s*(\d{1,2})$/i;

    let timer;
    function apply() {
      const q = input.value.trim().toLowerCase();
      const lesson = LESSON.exec(q);
      wclear.hidden = input.value === "";

      /* Root matching only kicks in for a real word. On two or three letters
         every stem in the language is a prefix of something and the filter
         stops filtering. */
      const latin = !lesson && q.length >= 2 && LATIN.test(q) ? foldLatin(q) : "";
      const qs = !lesson && q.length >= 4 ? stemOf(q) : "";
      const kin = qs.length >= 2;

      let shown = 0;
      let related = 0;
      for (const r of rows) {
        let direct, root = false;
        if (lesson) {
          direct = r.dataset.lesson === String(Number(lesson[1]));
        } else {
          direct = !q || r.dataset.k.includes(q) || (latin && r.dataset.k.includes(latin));
          root = !direct && kin && (r.dataset.stem || "").startsWith(qs);
        }
        r.hidden = !(direct || root);
        r.classList.remove("is-hit", "is-kin");
        if (root) r.classList.add("is-kin");
        if (direct || root) shown++;
        if (root) related++;
      }

      /* The alphabet survives a lesson filter, which leaves the list in
         alphabetical order, but not a text query: that reorders the rows by how
         well they answer it, and a letter over a ranked list is a lie. */
      const ranked = q && !lesson;
      for (const g of groups) {
        g.head.hidden = ranked || (q ? !g.rows.some((r) => !r.hidden) : false);
      }

      const frag = document.createDocumentFragment();
      if (ranked) {
        const matched = rows
          .filter((r) => !r.hidden)
          /* Ties go to the shorter word: it is the more exact answer to the
             same query, ոչ before ոչ ալկոհոլային խմիչքներ. */
          .sort((a, b) =>
            rank(a, q, latin) - rank(b, q, latin) ||
            (a.dataset.hy || "").length - (b.dataset.hy || "").length);
        for (const r of matched) frag.append(r);
        tbody.prepend(frag);
        if (matched.length && rank(matched[0], q, latin) < 2) matched[0].classList.add("is-hit");
      } else {
        for (const r of original) frag.append(r);
        tbody.append(frag);
      }

      /* Counted against the words, not against `original`, which also holds the
         letter dividers. */
      count.textContent =
        shown === rows.length
          ? String(rows.length)
          : lesson
            ? shown + " in lesson " + Number(lesson[1])
            : shown + " / " + rows.length + (related ? " · " + related + " by root" : "");
      empty.hidden = shown !== 0;
    }

    input?.addEventListener("input", () => {
      wclear.hidden = input.value === "";
      clearTimeout(timer);
      timer = setTimeout(apply, 90);
    });

    wclear?.addEventListener("click", () => {
      input.value = "";
      input.focus();
      apply();
    });

    /* A lesson page links here with ?q=L7, the alphabet on the home page with
       ?q=<word>. */
    const wanted = new URLSearchParams(location.search).get("q");
    if (wanted && input) {
      input.value = wanted;
      apply();
      const hit = document.querySelector("tbody tr.is-hit") || document.querySelector("tbody tr[data-k]:not([hidden])");
      hit?.scrollIntoView({ block: "center", behavior: "instant" });
      input.focus({ preventScroll: true });
    }
    /* Filtered, ordered and scrolled. Now it can be looked at. */
    delete document.documentElement.dataset.filtering;
  </script>

  <style is:global>
    /* Set by the script above the table and cleared by the one below it. Only
       the rows are held back: the field, the count and the topics are already
       correct, and blanking the page would be its own kind of flicker. */
    :root[data-filtering] .table-wrap { visibility: hidden; }
  </style>

  <style>
    .topics-fold { margin: var(--s-4) 0 var(--s-24); }
    .topics { display: flex; flex-wrap: wrap; gap: var(--s-8) var(--s-24); margin: 0; }

    .topic {
      font-size: var(--t-14);
      line-height: var(--lh-14);
      /* 24px of hit area for a 20px line (WCAG 2.5.8). */
      padding: var(--s-4) 0;
      text-decoration: none;
      color: var(--c-ink);
      transition: color 0.14s ease;
    }
    .topic:hover { color: var(--c-grey); }

    .filter { display: flex; align-items: baseline; gap: var(--s-16); margin: 0 0 var(--s-8); }

    .filter input {
      flex: 1;
      padding: var(--s-8) 0;
      border: 0;
      /* A field's underline is a control boundary, not a separator: 3:1. */
      border-bottom: 1px solid var(--c-line-strong);
      background: none;
      color: var(--c-ink);
      font: inherit;
      /* 17px, like every other input: iOS zooms a field set below 16px. */
      font-size: var(--t-17);
      line-height: var(--lh-17);
    }

    .filter input:focus { outline: none; border-bottom-color: var(--c-ink); }
    .filter input::-webkit-search-decoration,
    .filter input::-webkit-search-cancel-button { -webkit-appearance: none; }

    .filter__clear {
      align-self: center;
      display: grid;
      place-items: center;
      width: var(--s-32);
      height: var(--s-32);
      appearance: none;
      border: 0;
      background: none;
      padding: 0;
      color: var(--c-grey);
      cursor: pointer;
      transition: color .15s ease;
    }
    .filter__clear:hover { color: var(--c-ink); }
    .filter input::placeholder { color: var(--c-grey); }
    .filter__count { color: var(--c-grey); font-size: var(--label); line-height: var(--lh-14); font-variant-numeric: tabular-nums; white-space: nowrap; }

    .filter__empty { color: var(--c-grey); padding: var(--s-32) 0; font-size: var(--label); line-height: var(--lh-14); }
  </style>
</Base>
